Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

# GPU build of taso (yycdavid fork) + tensat, for the E-graphs for
# Verifiability project. Replaces the original docker/Dockerfile's CUDA
# 10.0/Ubuntu 16.04 base (too old for Ada/L40S, needs CUDA >=11.8) with a
# CUDA 12.4 + Ubuntu 22.04 base and cuDNN 9.
#
# Build (from this file's directory, on a node with disk quota headroom --
# NOT the login node's home dir):
#   export APPTAINER_CACHEDIR=/mmfs1/gscratch/scrubbed/sgvtc/apptainer_cache
#   export APPTAINER_TMPDIR=/mmfs1/gscratch/scrubbed/sgvtc/apptainer_tmp
#   apptainer build --fakeroot tensat.sif tensat.def
#
# Run (repo root, with taso/, egg/, tensat/ as siblings):
#   apptainer exec --nv tensat.sif bash

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential cmake git wget curl ca-certificates ninja-build \
        llvm-dev libclang-dev clang \
        libcudnn9-dev-cuda-12 libcudnn9-cuda-12 \
        python3 python3-dev python3-pip python3-venv \
        graphviz vim
    rm -rf /var/lib/apt/lists/*

    # Miniconda, for protobuf 3.21 specifically. taso/CMakeLists.txt was
    # bumped to cxx_std_17 on the Mac dev build to compile against 3.21
    # headers; anything newer than 3.21 pulls in an abseil-logging dep
    # taso's CMake doesn't link against, and older (e.g. apt's ~3.12) is
    # untested against the current CMakeLists.txt/rules.proto. 3.21 is the
    # only version actually validated so far -- see TENSAT_SUMMARY.md 9.1.
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh
    # Anaconda's default channels (pkgs/main, pkgs/r) now require an
    # interactive Terms-of-Service acceptance that blocks non-interactive
    # installs. We only ever use conda-forge, so just drop defaults instead.
    /opt/conda/bin/conda config --system --remove channels defaults || true
    # conda-forge's top-level "protobuf" package (Python bindings) skipped
    # straight from 3.20.x to 6.x/7.x -- the C++ library at the version
    # validated for taso/CMakeLists.txt (3.21.x) is under "libprotobuf"
    # instead. NOTE: conda-forge's onnx/numpy/cython builds now hard-pin a
    # matching modern libprotobuf, so they can't coexist with
    # libprotobuf=3.21.12 in one env -- dropped here. Only needed later for
    # TASO's own Python bindings (taso/python/setup.py, for loading real
    # trained ONNX models); that'll need its own env/version pinning pass
    # when we get there.
    /opt/conda/bin/conda install -y -c conda-forge libprotobuf=3.21.12
    /opt/conda/bin/conda clean -ya

    # OR-Tools (SCIP) for ILP extraction
    /opt/conda/bin/pip install --no-cache-dir ortools

    # Rust toolchain for tensat, into a container-wide location (not
    # $HOME, which won't be writable/persistent the same way at runtime)
    export CARGO_HOME=/opt/cargo
    export RUSTUP_HOME=/opt/rustup
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --default-toolchain stable --profile default

%environment
    export PATH=/opt/conda/bin:/opt/cargo/bin:$PATH
    export CARGO_HOME=/opt/cargo
    export RUSTUP_HOME=/opt/rustup
    export LD_LIBRARY_PATH=/opt/conda/lib:$LD_LIBRARY_PATH

%labels
    Author E-graphs-for-Verifiability project
    Base nvidia/cuda:12.4.1-devel-ubuntu22.04

%help
    GPU build environment for taso (yycdavid fork) + tensat + egg (yycdavid
    fork). Mount/bind the project root so taso/, egg/, tensat/ are visible
    as siblings, then inside the container:
        cd taso && mkdir -p build && cd build && cmake .. && make -j$(nproc)
        cd tensat && TASO_LIB_DIR=../taso/build TASO_INCLUDE_DIR=../taso/include \
            PROTOBUF_LIB_DIR=/opt/conda/lib cargo build --release
